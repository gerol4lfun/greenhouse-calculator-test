{
  "name": "greenhouse-calculator",
  "version": "1.0.0",
  "description": "Greenhouse calculator with knowledge base",
  "_projectVersion": "v293",
  "main": "index.js",
  "scripts": {
    "kb:import": "node scripts/import_kb.js",
    "kb:search": "node scripts/getKnowledgeBase.js",
    "beds:import": "node scripts/load_beds_normalized.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:delivery-probe": "playwright test edit-order-delivery-probe.spec.js --project=delivery-probe",
    "test:core-mechanics": "playwright test core-calculator-mechanics.spec.js --project=core-mechanics",
    "test:edit-integrity": "playwright test edit-order-integrity.spec.js --project=edit-integrity",
    "test:edit-order:staging": "BASE_URL=https://gerol4lfun.github.io/greenhouse-calculator-test/ playwright test edit-order.spec.js --project=edit-order-legacy -g \"existing-order-paid-extra|existing-order-date-only-integrity|existing-order-address-change-delivery-integrity\""
  },
  "keywords": [
    "greenhouse",
    "calculator",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.28.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
